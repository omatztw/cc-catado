# ===========================================
# ローカル開発環境
# ===========================================

# Redis設定
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=catado:

# Socket.ioサーバー設定
SOCKET_PORT=3001
CORS_ORIGIN=http://localhost:3000

# クライアント設定（Next.js用）
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# デバッグ設定
NEXT_PUBLIC_DEBUG_BOARD=false  # true にするとボード上に頂点座標を表示

# AI CPU プレイヤー設定
AI_PROVIDER=gemini  # "gemini", "deepseek", または "openrouter"
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
AI_MODEL=  # 空の場合はプロバイダーのデフォルトモデル (gemini-2.0-flash-exp / deepseek-chat / google/gemini-2.0-flash-exp:free)
AI_THINKING_DELAY=1500  # AIの思考時間（ミリ秒）- 人間らしさのための遅延

# ログイン・セッション管理
LOGIN_SECRET=catado-default-secret-key-change-in-production
ROOM_INACTIVE_TIMEOUT_MS=1800000  # 非アクティブルーム削除時間（30分）
ROOM_CLEANUP_INTERVAL_MS=300000   # クリーンアップチェック間隔（5分）

# ===========================================
# 本番環境（Vercel + Fly.io + Upstash）
# ===========================================
#
# --- Vercel (フロントエンド) 環境変数 ---
# NEXT_PUBLIC_SOCKET_URL=https://catado-server.fly.dev
# NEXT_PUBLIC_DEBUG_BOARD=false
#
# --- Fly.io (Socket.ioサーバー) 環境変数 ---
# fly secrets set コマンドで設定:
#   fly secrets set REDIS_URL="redis://default:xxxxx@xxx.upstash.io:6379"
#   fly secrets set REDIS_PREFIX="catado:"
#   fly secrets set CORS_ORIGIN="https://your-app.vercel.app"
#   fly secrets set LOGIN_SECRET="your-secure-secret-key"
#   fly secrets set AI_PROVIDER="gemini"
#   fly secrets set GEMINI_API_KEY="your-api-key"
#
# --- Upstash Redis ---
# REDIS_URL は Upstash コンソールから取得
# 形式: redis://default:<password>@<endpoint>:6379
